QMainWindow {
    background: #FBFAF4;
    color: #294D3C;
}

#navigation {
    background: #294D3C;
    min-width: 190px;
    max-width: 190px;
}

#navigation QPushButton {
    color: #BED3C7;
    background: transparent;
    border: 0;
    padding: 13px;
    text-align: left;
    border-radius: 10px;
}

#navigation QPushButton:hover {
    background: #3A6651;
    color: #FFFDF8;
}

#navigation QPushButton:focus {
    border: 2px solid #F1B232;
    padding: 11px;
}

#navigation QPushButton:checked {
    background: #FBFAF4;
    color: #294D3C;
    border-left: 4px solid #2FA47D;
    padding-left: 9px;
}

QPushButton[primary="true"] {
    background: #294D3C;
    color: #FFFDF8;
    padding: 10px 16px;
    border-radius: 10px;
}

QPushButton[primary="true"]:focus {
    border: 2px solid #F1B232;
    padding: 8px 14px;
}

QFrame[card="true"] {
    background: #FFFDF8;
    border: 1px solid #DEDCCF;
    border-radius: 16px;
}

QLabel[heading="true"] {
    color: #24386F;
    font-size: 22px;
    font-weight: 700;
}

QLabel[accent="true"] {
    color: #F1B232;
}
