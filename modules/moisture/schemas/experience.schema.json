{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved structured moisture experience",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experience_id", "version", "status", "title", "source",
    "applicable_suppliers", "applicable_materials", "applicable_seasons",
    "applicable_metrics", "author", "reviewer", "evidence_sources",
    "effective_at", "supersedes"
  ],
  "properties": {
    "experience_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "version": {"type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"},
    "status": {"type": "string", "enum": ["draft", "pending_review", "approved", "retired"]},
    "title": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "applicable_suppliers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "applicable_materials": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "applicable_seasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "applicable_metrics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "author": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "evidence_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "effective_at": {"type": "string", "format": "date-time"},
    "supersedes": {
      "anyOf": [
        {"type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"},
        {"type": "null"}
      ]
    }
  }
}
