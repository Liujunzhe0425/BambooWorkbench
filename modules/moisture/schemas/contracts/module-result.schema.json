{
  "$defs": {
    "Anomaly": {
      "additionalProperties": false,
      "properties": {
        "anomaly_id": {
          "title": "Anomaly Id",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        },
        "value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "anomaly_id",
        "severity",
        "field",
        "message",
        "source"
      ],
      "title": "Anomaly",
      "type": "object"
    },
    "ConfirmationPrompt": {
      "additionalProperties": false,
      "properties": {
        "batch_applicable": {
          "title": "Batch Applicable",
          "type": "boolean"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "confirmation_id": {
          "title": "Confirmation Id",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "learning": {
          "anyOf": [
            {
              "$ref": "#/$defs/LearningDescriptor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "options": {
          "items": {},
          "title": "Options",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "rememberable": {
          "title": "Rememberable",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "suggested_value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Value"
        },
        "value_type": {
          "default": "text",
          "enum": [
            "text",
            "date"
          ],
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "confirmation_id",
        "field",
        "reason",
        "confidence",
        "blocking",
        "batch_applicable",
        "rememberable",
        "source"
      ],
      "title": "ConfirmationPrompt",
      "type": "object"
    },
    "FileResult": {
      "additionalProperties": false,
      "properties": {
        "anomaly_count": {
          "minimum": 0,
          "title": "Anomaly Count",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "extracted_records": {
          "minimum": 0,
          "title": "Extracted Records",
          "type": "integer"
        },
        "fingerprint": {
          "title": "Fingerprint",
          "type": "string"
        },
        "missing_fields": {
          "items": {
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        }
      },
      "required": [
        "source_file",
        "fingerprint",
        "status",
        "extracted_records",
        "anomaly_count"
      ],
      "title": "FileResult",
      "type": "object"
    },
    "LearningCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "label"
      ],
      "title": "LearningCandidate",
      "type": "object"
    },
    "LearningDescriptor": {
      "additionalProperties": false,
      "description": "Module-owned, structured and redacted preference-learning description.",
      "properties": {
        "base_suggestion_id": {
          "title": "Base Suggestion Id",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/LearningCandidate"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        },
        "context": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Context",
          "type": "object"
        },
        "context_levels": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Context Levels",
          "type": "array"
        },
        "field": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "learning_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Learning Key",
          "type": "string"
        },
        "preference_adjustable": {
          "default": true,
          "title": "Preference Adjustable",
          "type": "boolean"
        },
        "schema_version": {
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "learning_key",
        "field",
        "context",
        "context_levels",
        "candidates",
        "base_suggestion_id"
      ],
      "title": "LearningDescriptor",
      "type": "object"
    },
    "ModuleId": {
      "enum": [
        "moisture",
        "boiling",
        "after_sales"
      ],
      "title": "ModuleId",
      "type": "string"
    },
    "MonthlySnapshotArtifact": {
      "additionalProperties": false,
      "properties": {
        "month": {
          "maximum": 12,
          "minimum": 1,
          "title": "Month",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_format": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Snapshot Format",
          "type": "string"
        },
        "year": {
          "maximum": 9999,
          "minimum": 2000,
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "path",
        "snapshot_format",
        "year",
        "month"
      ],
      "title": "MonthlySnapshotArtifact",
      "type": "object"
    },
    "OutputArtifact": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "mime_type": {
          "title": "Mime Type",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "path",
        "label",
        "mime_type"
      ],
      "title": "OutputArtifact",
      "type": "object"
    },
    "ResultSummary": {
      "additionalProperties": false,
      "properties": {
        "anomaly_count": {
          "minimum": 0,
          "title": "Anomaly Count",
          "type": "integer"
        },
        "confirmation_count": {
          "minimum": 0,
          "title": "Confirmation Count",
          "type": "integer"
        },
        "failed_count": {
          "minimum": 0,
          "title": "Failed Count",
          "type": "integer"
        },
        "input_count": {
          "minimum": 0,
          "title": "Input Count",
          "type": "integer"
        },
        "processed_count": {
          "minimum": 0,
          "title": "Processed Count",
          "type": "integer"
        },
        "skipped_count": {
          "minimum": 0,
          "title": "Skipped Count",
          "type": "integer"
        }
      },
      "required": [
        "input_count",
        "processed_count",
        "skipped_count",
        "failed_count",
        "anomaly_count",
        "confirmation_count"
      ],
      "title": "ResultSummary",
      "type": "object"
    },
    "ServiceRequest": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "purpose": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "requires_user_consent": {
          "default": true,
          "title": "Requires User Consent",
          "type": "boolean"
        },
        "response_format": {
          "default": "text",
          "enum": [
            "text",
            "json_object"
          ],
          "title": "Response Format",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "service": {
          "enum": [
            "knowledge",
            "ai"
          ],
          "title": "Service",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "service",
        "purpose",
        "payload"
      ],
      "title": "ServiceRequest",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "cell_or_range": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Or Range"
        },
        "sheet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        }
      },
      "required": [
        "source_file"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TaskStatus": {
      "enum": [
        "success",
        "partial_success",
        "needs_confirmation",
        "failed",
        "cancelled"
      ],
      "title": "TaskStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Analysis Summary"
    },
    "anomalies": {
      "items": {
        "$ref": "#/$defs/Anomaly"
      },
      "title": "Anomalies",
      "type": "array"
    },
    "confirmations": {
      "items": {
        "$ref": "#/$defs/ConfirmationPrompt"
      },
      "title": "Confirmations",
      "type": "array"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "file_results": {
      "items": {
        "$ref": "#/$defs/FileResult"
      },
      "title": "File Results",
      "type": "array"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "module_id": {
      "$ref": "#/$defs/ModuleId"
    },
    "module_version": {
      "title": "Module Version",
      "type": "string"
    },
    "monthly_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/MonthlySnapshotArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/OutputArtifact"
      },
      "title": "Outputs",
      "type": "array"
    },
    "rule_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rule Version"
    },
    "schema_version": {
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "service_requests": {
      "items": {
        "$ref": "#/$defs/ServiceRequest"
      },
      "title": "Service Requests",
      "type": "array"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/TaskStatus"
    },
    "summary": {
      "$ref": "#/$defs/ResultSummary"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "module_id",
    "module_version",
    "status",
    "summary",
    "started_at",
    "finished_at"
  ],
  "title": "ModuleResult",
  "type": "object"
}
