{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bamboo:moisture:module-config:1.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_year": {"type": "integer", "minimum": 1900, "maximum": 2100}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "operation": {"const": "summary"},
        "default_year": {"type": "integer", "minimum": 1900, "maximum": 2100},
        "rule_selection": {"$ref": "#/$defs/rule_selection"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "inputs"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "operation": {"const": "append_summary"},
        "default_year": {"type": "integer", "minimum": 1900, "maximum": 2100},
        "rule_selection": {"$ref": "#/$defs/rule_selection"},
        "inputs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "input_index"],
            "properties": {
              "role": {"enum": ["base_summary", "new_raw"]},
              "input_index": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "inputs",
        "history_ids",
        "experience_selections",
        "question"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "operation": {"const": "ai_report"},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "input_index"],
            "properties": {
              "role": {"const": "current_summary"},
              "input_index": {"type": "integer", "minimum": 0}
            }
          }
        },
        "history_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stable_id"}
        },
        "experience_selections": {
          "type": "array",
          "maxItems": 50,
          "items": {"$ref": "#/$defs/experience_selection"}
        },
        "rule_selection": {"$ref": "#/$defs/rule_selection"},
        "question": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  ],
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "experience_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "version", "sha256"],
      "properties": {
        "entry_id": {"$ref": "#/$defs/stable_id"},
        "version": {"$ref": "#/$defs/stable_id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rule_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"$ref": "#/$defs/stable_id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
