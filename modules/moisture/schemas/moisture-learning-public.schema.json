{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bamboo:moisture:learning-public:1.0",
  "title": "Moisture Public Confirmation Learning Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "learning_key",
    "field",
    "context",
    "context_levels",
    "candidates",
    "base_suggestion_id",
    "preference_adjustable"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "learning_key": {
      "type": "string",
      "pattern": "^msr-learning-[0-9a-f]{24}$"
    },
    "field": {
      "enum": ["supplier", "department"]
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "context_levels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "const": ["field", "material_category", "source_category"]
        },
        {
          "const": ["field", "material_category"]
        },
        {
          "const": ["field"]
        }
      ],
      "items": false
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "base_suggestion_id": {
      "type": "string",
      "pattern": "^msr-candidate-[0-9a-f]{24}$"
    },
    "preference_adjustable": {
      "const": true
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "material_category", "source_category"],
      "properties": {
        "field": {
          "enum": ["supplier", "department"]
        },
        "material_category": {
          "enum": ["raw_bamboo_filament", "unspecified"]
        },
        "source_category": {
          "enum": [
            "workbook_header",
            "workbook_sample_rows",
            "unspecified"
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "label"],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^msr-candidate-[0-9a-f]{24}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    }
  }
}
