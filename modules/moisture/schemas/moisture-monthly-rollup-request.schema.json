{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bamboo:moisture:monthly-rollup-request:1.0",
  "title": "Moisture Monthly Rollup Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "module_id", "target_period",
    "snapshot_root", "output_dir", "network_allowed",
    "business_config", "snapshots"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "module_id": {"const": "moisture"},
    "target_period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "month"],
      "properties": {
        "year": {"type": "integer", "minimum": 1000, "maximum": 9999},
        "month": {"type": "integer", "minimum": 1, "maximum": 12}
      }
    },
    "snapshot_root": {"type": "string", "minLength": 1},
    "output_dir": {"type": "string", "minLength": 1},
    "network_allowed": {"const": false},
    "business_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"$ref": "#/$defs/safe_version"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/snapshot_ref"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "snapshot_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["month", "path", "sha256"],
      "properties": {
        "month": {"type": "integer", "minimum": 1, "maximum": 12},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
