{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AfterSalesConfirmationLearning",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "learning_key",
    "field",
    "context",
    "context_levels",
    "candidates",
    "base_suggestion_id",
    "preference_adjustable"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "learning_key": {"const": "after_sales.complaint_type.v1"},
    "field": {"const": "投诉类型"},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brand_group", "product_group"],
      "properties": {
        "brand_group": {"type": "string", "minLength": 1, "maxLength": 120},
        "product_group": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "context_levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "prefixItems": [
        {"const": ["brand_group", "product_group"]},
        {"const": ["brand_group"]}
      ],
      "items": false
    },
    "candidates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "label"],
        "properties": {
          "candidate_id": {
            "enum": ["performance", "appearance", "processing", "other"]
          },
          "label": {"enum": ["性能", "外观", "加工", "其他"]}
        }
      }
    },
    "base_suggestion_id": {
      "enum": ["performance", "appearance", "processing", "other"]
    },
    "preference_adjustable": {"const": true}
  }
}
