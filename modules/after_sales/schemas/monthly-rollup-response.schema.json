{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AfterSalesMonthlyRollupResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "module_id",
    "module_version",
    "status",
    "year",
    "target_month",
    "used_months",
    "snapshot_hashes",
    "outputs",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string"},
    "module_id": {"const": "after_sales"},
    "module_version": {"pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "status": {"enum": ["success", "failed"]},
    "year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2200},
    "target_month": {"type": ["integer", "null"], "minimum": 1, "maximum": 12},
    "used_months": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1, "maximum": 12}
    },
    "snapshot_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["month", "sha256"],
        "properties": {
          "month": {"type": "integer", "minimum": 1, "maximum": 12},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path", "label", "mime_type", "sha256"],
        "properties": {
          "type": {"type": "string"},
          "path": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "mime_type": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
