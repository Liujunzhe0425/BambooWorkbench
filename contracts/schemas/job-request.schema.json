{
  "$defs": {
    "JobPhase": {
      "enum": [
        "draft",
        "finalize"
      ],
      "title": "JobPhase",
      "type": "string"
    },
    "ModuleId": {
      "enum": [
        "moisture",
        "boiling",
        "after_sales"
      ],
      "title": "ModuleId",
      "type": "string"
    },
    "RunMode": {
      "enum": [
        "single",
        "batch",
        "incremental"
      ],
      "title": "RunMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ai_enabled": {
      "default": false,
      "title": "Ai Enabled",
      "type": "boolean"
    },
    "allowed_knowledge_scopes": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Knowledge Scopes",
      "type": "array"
    },
    "confirmation_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmation File"
    },
    "input_files": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Input Files",
      "type": "array"
    },
    "job_id": {
      "pattern": "^[A-Za-z0-9-]{6,64}$",
      "title": "Job Id",
      "type": "string"
    },
    "learning_enabled": {
      "default": true,
      "title": "Learning Enabled",
      "type": "boolean"
    },
    "module_config_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Module Config File"
    },
    "module_id": {
      "$ref": "#/$defs/ModuleId"
    },
    "output_dir": {
      "title": "Output Dir",
      "type": "string"
    },
    "parent_job_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Job Id"
    },
    "period_month": {
      "anyOf": [
        {
          "maximum": 12,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Period Month"
    },
    "period_year": {
      "anyOf": [
        {
          "maximum": 9999,
          "minimum": 2000,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Period Year"
    },
    "phase": {
      "$ref": "#/$defs/JobPhase"
    },
    "run_mode": {
      "$ref": "#/$defs/RunMode"
    },
    "schema_version": {
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "service_response_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Service Response File"
    },
    "task_name": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Name"
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "module_id",
    "phase",
    "run_mode",
    "input_files",
    "output_dir"
  ],
  "title": "JobRequest",
  "type": "object"
}
