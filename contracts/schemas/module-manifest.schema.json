{
  "$defs": {
    "ModuleId": {
      "enum": [
        "moisture",
        "boiling",
        "after_sales"
      ],
      "title": "ModuleId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Capabilities",
      "type": "array"
    },
    "entrypoint": {
      "minLength": 1,
      "title": "Entrypoint",
      "type": "string"
    },
    "management_entrypoint": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Management Entrypoint"
    },
    "module_id": {
      "$ref": "#/$defs/ModuleId"
    },
    "module_name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Module Name",
      "type": "string"
    },
    "module_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Module Version",
      "type": "string"
    },
    "requires_network": {
      "title": "Requires Network",
      "type": "boolean"
    },
    "schema_version": {
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "supported_extensions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Supported Extensions",
      "type": "array"
    },
    "supports_batch": {
      "title": "Supports Batch",
      "type": "boolean"
    },
    "supports_incremental": {
      "title": "Supports Incremental",
      "type": "boolean"
    },
    "supports_single_file": {
      "title": "Supports Single File",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "module_id",
    "module_name",
    "module_version",
    "entrypoint",
    "supported_extensions",
    "supports_single_file",
    "supports_batch",
    "supports_incremental",
    "requires_network"
  ],
  "title": "ModuleManifest",
  "type": "object"
}
